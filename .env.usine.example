# ===== USINE À ROBOTS (service Railway séparé de ton canal VIP) =====
# Commande de démarrage du service : python usine.py

# 1) Jeton de TON robot de vente (nouveau robot créé avec @BotFather, PAS celui du canal VIP)
USINE_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2) Ton identifiant Telegram (notifications + commandes /clients, /prolonger...). Plusieurs : 111,222
OWNER_IDS=123456789

# 3) Offre
TRIAL_DAYS=7          # jours d'essai gratuit
SUB_DAYS=30           # jours ajoutés par paiement
PRICE_STARS=1500      # prix en Telegram Stars (0 = pas de paiement en ligne, prolongation à la main)
REMIND_DAYS=3         # rappel X jours avant la fin
MAX_BOTS_PER_USER=1
OPEN_SIGNUP=true      # false = toi seul peux créer des robots
SUPPORT_CONTACT=@ton_pseudo

# 4) Stockage : sur Railway, ajoute un volume (ex : /data). Il est détecté automatiquement.
# DATA_DIR=/data
