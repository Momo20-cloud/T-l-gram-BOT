# 1) Jeton donné par @BotFather
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2) ID du canal VIP (commence par -100...). Transfère un message du canal au robot pour l'obtenir.
CHANNEL_ID=-1001234567890

# 3) Ton identifiant Telegram (envoie /id au robot). Plusieurs possibles : 111,222
ADMIN_IDS=123456789

# Fuseau horaire affiché dans les signaux et utilisé pour les bilans
TIMEZONE=UTC
# autres exemples : Africa/Casablanca, Africa/Algiers, Africa/Tunis, Europe/Paris

# Boutons rapides d'actifs
QUICK_PAIRS=XAUUSD,BTCUSD,EURUSD,GBPUSD

# Bilan automatique (lun→ven) à cette heure. Laisse vide pour désactiver.
DAILY_REPORT_TIME=22:00
# Jour du bilan hebdo : lundi, mardi, ..., vendredi, samedi, dimanche
WEEKLY_REPORT_DAY=vendredi

# Bandeau "ANONYMETRADER VIP" ajouté en bas des photos (true/false)
WATERMARK=true

# Emplacement de la base de données (sur Railway : /data/signals.db avec un volume)
DB_PATH=signals.db
